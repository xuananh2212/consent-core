# Địa chỉ Consent Core, không có dấu / ở cuối.
# Local để trống: request /api đi qua proxy của Vite.
# Production điền origin thật rồi chạy npm run build, ví dụ https://consent-core.example.com
# Vite gắn giá trị này lúc build. Đổi file sau khi build thì phải build lại.
VITE_API_BASE_URL=

# Máy Consent Core khi chạy dev/preview. Không có tiền tố VITE_ nên không vào bundle.
API_PROXY_TARGET=http://127.0.0.1:8081
