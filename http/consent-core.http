### Consent Core end-to-end smoke tests for IntelliJ HTTP Client
### Select the "local" environment from http/client.env.json (baseUrl, tenantId, actorId, actorType, sourceSystem).
###
### Sections
###   A. Policies                        (1)
###   B. Browser flow as Flow Manager    (B1 - B9)   subject bound at PREPARE
###   C. App-to-App flow as Flow Manager (C1 - C7)   subject bound at AUTHORIZE / REJECT
###   D. Negative checks                 (D1 - D4)
###   E. Trusted partner consent         (E1 - E5)
###   F. Evidence-required branch consent(F1 - F8)
###   G. Operations                      (G1 - G3)
###
### validFrom / validUntil of the sample consents must contain "now" (Core rejects authorize outside the
### validity window): adjust the dates when they are in the past.
###
### Flow Manager calls (/internal/v1/**) must use the Flow Manager service identity. In header mode
### Core requires X-Source-System to be equal to interaction.sourceSystem of authorize/reject, so both
### use {{fmSource}} below (the value Flow Manager's RestConsentCoreAdapter sends).

@fmActor = svc:consent-flow-manager
@fmSource = CONSENT_FLOW_MANAGER
@tppClient = tpp-web
@issuer = http://localhost:8080/realms/open-banking

###############################################################################
### A. POLICIES
###############################################################################

### 1. Consent-type policy shared by browser, app-to-app and trusted partner consents.
###    requireSubject=false: a TPP registers the consent before the PSU is known.
###    The trusted partner consent (E) still sends subjectId, which is allowed.
POST {{baseUrl}}/api/v1/admin/policies/consent-types
Content-Type: application/json
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{actorId}}
X-Actor-Type: {{actorType}}
X-Source-System: {{sourceSystem}}

{
  "consentType": "ACCOUNT_INFORMATION",
  "evidencePolicy": "NOT_REQUIRED",
  "maxValidityDays": 365,
  "requireSubject": false,
  "allowTrustedAutoAuthorization": true,
  "allowedChannels": ["WEB", "MOBILE", "APP_TO_APP", "PARTNER"]
}

### Expected: 201 Created, body = policy id

###############################################################################
### B. BROWSER FLOW (what Flow Manager does after the PSU logged in at Keycloak)
###    REGISTERED (no subject) --prepare(BROWSER_REDIRECT, subjectRef)--> AWAITING_AUTHORIZATION (subject bound)
###    --authorize--> AUTHORIZED
###############################################################################

### B1. TPP registers a consent WITHOUT subjectId
POST {{baseUrl}}/api/v1/consents
Content-Type: application/json
Idempotency-Key: browser-register-{{$uuid}}
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{tppClient}}
X-Actor-Type: SERVICE
X-Source-System: {{tppClient}}

{
  "externalRequestId": "browser-{{$uuid}}",
  "consentType": "ACCOUNT_INFORMATION",
  "clientId": "{{tppClient}}",
  "purpose": "Read account information",
  "validFrom": "2026-09-01T00:00:00Z",
  "validUntil": "2026-12-01T00:00:00Z",
  "acquisitionChannel": "WEB",
  "captureMethod": "IN_APP_CONFIRMATION",
  "sourceSystem": "{{tppClient}}",
  "evidencePolicy": "NOT_REQUIRED",
  "trustedSourceAuthorization": false,
  "content": {
    "purposeCode": "ACCOUNT_ACCESS",
    "permissions": [ {"permissionCode": "READ_BALANCE", "attributes": {}} ],
    "resources": [ {"resourceType": "ACCOUNT", "resourceId": "account-001", "attributes": {"currency": "VND"}} ],
    "constraints": [ {"constraintType": "ACCESS_FREQUENCY", "operator": "LTE", "value": 4} ],
    "obligations": [],
    "presentationSnapshot": {"title": "Chia sẻ thông tin tài khoản", "language": "vi"}
  }
}

> {%
    client.global.set("browserConsentId", response.body.id);
    client.test("registered without subject", () => {
        client.assert(response.status === 201, "expected 201");
        client.assert(response.body.status === "REGISTERED", "expected REGISTERED");
        client.assert(response.body.subjectId == null, "subjectId must be null");
    });
%}

### B2. FM: authorization context before prepare (subjectRef null, presentationReady false)
GET {{baseUrl}}/internal/v1/consents/{{browserConsentId}}/authorization-context
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{fmActor}}
X-Actor-Type: SERVICE
X-Source-System: {{fmSource}}

### B3. FM: prepare with interactionMode=BROWSER_REDIRECT -> subject is bound here
POST {{baseUrl}}/internal/v1/consents/{{browserConsentId}}/prepare-authorization
Content-Type: application/json
Idempotency-Key: prep:browser-{{browserConsentId}}:0
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{fmActor}}
X-Actor-Type: SERVICE
X-Source-System: {{fmSource}}

{
  "clientId": "{{tppClient}}",
  "scopes": ["openid", "accounts"],
  "subjectRef": "psu-001",
  "interactionMode": "BROWSER_REDIRECT"
}

> {%
    client.global.set("browserVersion", response.body.authorizationContext.consentVersion);
    client.global.set("browserRevision", response.body.authorizationContext.currentRevisionNo);
    client.global.set("browserHash", response.body.authorizationContext.currentContentHash);
    client.test("prepared and subject bound", () => {
        client.assert(response.body.preparationStatus === "PREPARED", "expected PREPARED");
        client.assert(response.body.authorizationContext.status === "AWAITING_AUTHORIZATION", "expected AWAITING_AUTHORIZATION");
        client.assert(response.body.authorizationContext.subjectRef === "psu-001", "subject must be bound at prepare");
    });
%}

### B4. FM: presentation of the prepared revision (what consent-ui shows)
GET {{baseUrl}}/internal/v1/consents/{{browserConsentId}}/presentation?revision={{browserRevision}}
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{fmActor}}
X-Actor-Type: SERVICE
X-Source-System: {{fmSource}}

### B5. FM: PSU approves. subjectRef must equal the subject bound in B3.
###     interaction.sourceInteractionRef = FM flowId; reuse the same value in B6.
POST {{baseUrl}}/internal/v1/consents/{{browserConsentId}}/authorize
Content-Type: application/json
Idempotency-Key: authz:browser-{{browserConsentId}}
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{fmActor}}
X-Actor-Type: SERVICE
X-Source-System: {{fmSource}}

{
  "authorizationReference": "flow:browser-{{browserConsentId}}",
  "expectedVersion": {{browserVersion}},
  "expectedRevisionNo": {{browserRevision}},
  "expectedContentHash": "{{browserHash}}",
  "clientId": "{{tppClient}}",
  "subjectRef": "psu-001",
  "authentication": {
    "subjectRef": "psu-001",
    "issuer": "{{issuer}}",
    "authenticationTime": "{{$isoTimestamp}}",
    "acr": "1",
    "amr": ["pwd"],
    "verificationProfile": "KEYCLOAK_BROWSER_V1"
  },
  "interaction": {
    "sourceSystem": "{{fmSource}}",
    "sourceInteractionRef": "flow-browser-{{browserConsentId}}",
    "authorizationServerRef": "keycloak:open-banking",
    "asTransactionRef": "as-txn-browser-{{browserConsentId}}"
  }
}

> {%
    client.test("authorized", () => {
        client.assert(response.body.status === "AUTHORIZED", "expected AUTHORIZED");
        client.assert(response.body.subjectId === "psu-001", "subject unchanged");
    });
%}

### B6. FM: authorization-validation before Keycloak issues the code (expect valid=true)
GET {{baseUrl}}/internal/v1/consents/{{browserConsentId}}/authorization-validation?clientId={{tppClient}}&subjectRef=psu-001&revisionNo={{browserRevision}}&contentHash={{browserHash}}&sourceInteractionRef=flow-browser-{{browserConsentId}}&authorizationServerRef=keycloak:open-banking&asTransactionRef=as-txn-browser-{{browserConsentId}}
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{fmActor}}
X-Actor-Type: SERVICE
X-Source-System: {{fmSource}}

> {% client.test("valid", () => client.assert(response.body.valid === true, JSON.stringify(response.body.reasonCodes))); %}

### B7. Consent after the decision
GET {{baseUrl}}/api/v1/consents/{{browserConsentId}}
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{actorId}}
X-Actor-Type: {{actorType}}
X-Source-System: {{sourceSystem}}

### B8. Decision capture: subject_id (decision_maker_id) = psu-001
GET {{baseUrl}}/api/v1/consents/{{browserConsentId}}/decisions
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{actorId}}
X-Actor-Type: {{actorType}}
X-Source-System: {{sourceSystem}}

### B9. Lifecycle history: REGISTERED -> AWAITING_AUTHORIZATION -> AUTHORIZED
GET {{baseUrl}}/api/v1/consents/{{browserConsentId}}/history
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{actorId}}
X-Actor-Type: {{actorType}}
X-Source-System: {{sourceSystem}}

###############################################################################
### C. APP-TO-APP FLOW (the PSU is only known when they decide in the bank app)
###    REGISTERED (no subject) --prepare(APP_TO_APP_REDIRECT, no subjectRef)--> AWAITING_AUTHORIZATION (no subject)
###    --authorize/reject(subjectRef)--> AUTHORIZED / REJECTED (subject bound)
###############################################################################

### C1. TPP registers a consent WITHOUT subjectId (app-to-app channel)
POST {{baseUrl}}/api/v1/consents
Content-Type: application/json
Idempotency-Key: app-register-{{$uuid}}
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{tppClient}}
X-Actor-Type: SERVICE
X-Source-System: {{tppClient}}

{
  "externalRequestId": "app-{{$uuid}}",
  "consentType": "ACCOUNT_INFORMATION",
  "clientId": "{{tppClient}}",
  "purpose": "Read account information",
  "validFrom": "2026-09-01T00:00:00Z",
  "validUntil": "2026-12-01T00:00:00Z",
  "acquisitionChannel": "APP_TO_APP",
  "captureMethod": "IN_APP_CONFIRMATION",
  "sourceSystem": "{{tppClient}}",
  "evidencePolicy": "NOT_REQUIRED",
  "trustedSourceAuthorization": false,
  "content": {
    "purposeCode": "ACCOUNT_ACCESS",
    "permissions": [ {"permissionCode": "READ_BALANCE", "attributes": {}} ],
    "resources": [ {"resourceType": "ACCOUNT", "resourceId": "account-001", "attributes": {"currency": "VND"}} ],
    "constraints": [],
    "obligations": [],
    "presentationSnapshot": {"title": "Chia sẻ thông tin tài khoản", "language": "vi"}
  }
}

> {% client.global.set("appConsentId", response.body.id); %}

### C2. FM: prepare with interactionMode=APP_TO_APP_REDIRECT and NO subjectRef
POST {{baseUrl}}/internal/v1/consents/{{appConsentId}}/prepare-authorization
Content-Type: application/json
Idempotency-Key: prep:app-{{appConsentId}}:0
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{fmActor}}
X-Actor-Type: SERVICE
X-Source-System: {{fmSource}}

{
  "clientId": "{{tppClient}}",
  "scopes": ["openid", "accounts"],
  "interactionMode": "APP_TO_APP_REDIRECT"
}

> {%
    client.global.set("appVersion", response.body.authorizationContext.consentVersion);
    client.global.set("appRevision", response.body.authorizationContext.currentRevisionNo);
    client.global.set("appHash", response.body.authorizationContext.currentContentHash);
    client.test("prepared without subject", () => {
        client.assert(response.body.preparationStatus === "PREPARED", "expected PREPARED");
        client.assert(response.body.authorizationContext.subjectRef == null, "subject must still be null");
    });
%}

### C3. FM: presentation shown in the bank app
GET {{baseUrl}}/internal/v1/consents/{{appConsentId}}/presentation?revision={{appRevision}}
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{fmActor}}
X-Actor-Type: SERVICE
X-Source-System: {{fmSource}}

### C4. FM: PSU approves in the bank app -> subject bound here (from the Bank IAM assertion)
POST {{baseUrl}}/internal/v1/consents/{{appConsentId}}/authorize
Content-Type: application/json
Idempotency-Key: authz:app-{{appConsentId}}
X-Tenant-Id: {{tenantId}}
X-Actor-Id: {{fmActor}}
